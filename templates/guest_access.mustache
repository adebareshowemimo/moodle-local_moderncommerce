<div class="mc-modern-learner-dashboard mc-modern-learner-page mc-guest-checkout">
    <header class="mc-modern-learner-hero">
        <h1>{{#str}}guestaccesstitle, local_moderncommerce{{/str}}</h1>
        <p>{{#str}}guestaccessintro, local_moderncommerce{{/str}}</p>
    </header>
    <div class="mc-modern-learner-shell">
        <aside class="mc-modern-learner-sidebar mc-guest-checkout__details">
            <h2>{{#str}}guestaccesssecuritytitle, local_moderncommerce{{/str}}</h2>
            <p>{{#str}}guestaccesssecurity, local_moderncommerce{{/str}}</p>
            <a href="{{supporturl}}">{{#str}}guestaccesssupport, local_moderncommerce{{/str}}</a>
        </aside>
        <div class="mc-modern-learner-main">
            {{{errorhtml}}}
            <section class="mc-card">
              <div class="mc-card-body">
                {{#available}}
                    <h2>{{#str}}guestaccesssend, local_moderncommerce{{/str}}</h2>
                    <p>{{#str}}guestaccesshelp, local_moderncommerce{{/str}}</p>
                    {{{formhtml}}}
                {{/available}}
                {{#sent}}
                    <h2>{{#str}}guestaccesssenttitle, local_moderncommerce{{/str}}</h2>
                    <p role="status">{{#str}}guestaccesssent, local_moderncommerce{{/str}}</p>
                {{/sent}}
                {{#invalid}}
                    <h2>{{#str}}guestaccessinvalidtitle, local_moderncommerce{{/str}}</h2>
                    <p>{{#str}}guestaccessinvalid, local_moderncommerce{{/str}}</p>
                {{/invalid}}
                <a href="{{learningurl}}" class="mc-button btn-mc-secondary">{{#str}}guestaccesslearning, local_moderncommerce{{/str}}</a>
              </div>
            </section>
        </div>
    </div>
</div>
