<div class="mc-modern-learner-dashboard mc-modern-learner-page mc-guest-checkout">
    <header class="mc-modern-learner-hero">
        <h1>{{#str}}mcpasswordtitle, local_moderncommerce{{/str}}</h1>
        <p>{{#str}}mcpasswordintro, local_moderncommerce{{/str}}</p>
    </header>
    <div class="mc-modern-learner-shell">
        <aside class="mc-modern-learner-sidebar mc-guest-checkout__details">
            <h2>{{#str}}mcpasswordsecuritytitle, local_moderncommerce{{/str}}</h2>
            <p>{{#str}}mcpasswordsecurity, local_moderncommerce{{/str}}</p>
            <a href="{{supporturl}}">{{#str}}guestaccesssupport, local_moderncommerce{{/str}}</a>
        </aside>
        <div class="mc-modern-learner-main">
            {{{errorhtml}}}
            <section class="mc-card">
                <div class="mc-card-body">
                    <h2>{{statetitle}}</h2>
                    {{#available}}{{{formhtml}}}{{/available}}
                    {{#unavailable}}<p role="status">{{statemessage}}</p>{{/unavailable}}
                    {{#renewalurl}}
                        <p><a href="{{renewalurl}}">{{#str}}mcpasswordrequest, local_moderncommerce{{/str}}</a></p>
                    {{/renewalurl}}
                    {{#unavailable}}
                        <a href="{{learningurl}}" class="mc-button btn-mc-secondary">{{#str}}guestaccesslearning, local_moderncommerce{{/str}}</a>
                    {{/unavailable}}
                </div>
            </section>
        </div>
    </div>
</div>
